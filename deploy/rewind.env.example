# Copy this file to /srv/rewind/rewind.env on the host.
# Do not commit the copied file. Until HTTPS is configured, keep the wildcard
# only for a private smoke test; replace it with the final HTTPS origin before
# opening the application to other users.
REWIND_ALLOW_ORIGIN=*

# Runtime request bounds. These defaults match the server configuration; tune
# them only for the capacity of this single-host deployment.
REWIND_HTTP_IDLE_TIMEOUT_MS=30000
REWIND_HTTP_UPLOAD_TIMEOUT_MS=120000
REWIND_HTTP_MAX_CONCURRENT_INTAKES=2
REWIND_HTTP_MAX_CONCURRENT_PROCESSING=1

# The same-origin static web/proxy container listens on this host port.
REWIND_WEB_PORT=8080

# Required by deploy/backup.sh for an S3 upload. Keep the bucket private.
REWIND_BACKUP_BUCKET=rewind-demo-backups-330599756236
REWIND_BACKUP_PREFIX=rewind-demo

# Optional AWS CLI profile if the host is deliberately configured with the
# restricted backup identity. Do not put access keys in this file.
AWS_PROFILE=rewind-demo-backup
