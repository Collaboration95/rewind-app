account_id              = "330599756236"
operator_username       = "macos-m1"
backup_bucket_name      = "rewind-demo-backups-330599756236"
audit_bucket_name       = "rewind-audit-logs-330599756236"
# Optional. Leave empty when email notifications are not configured.
budget_email_recipients = []
# Optional. Leave empty when audit failure emails are not configured.
cost_safety_audit_email_recipients = []
# Optional managed publisher. Keep disabled unless a separately managed SNS
# topic ARN is intentionally configured; no recipient or credential is stored here.
cost_safety_audit_notification_mode     = "disabled"
cost_safety_audit_notification_topic_arn = null
ssh_cidr                = "YOUR.PUBLIC.IP.ADDRESS/32"
# Leave null for manual starts. Example: "cron(0 9 ? * MON-FRI *)"
automatic_start_schedule_expression = null
# Empty means no snapshots or global distributions are currently expected;
# the audit still checks inventory for unexpected resources.
cost_safety_expected_snapshot_names = []
cost_safety_expected_distributions  = {}
# The lifecycle scripts override this for reviewed hibernation/recovery plans.
demo_instance_enabled = true
# The audit expects a stopped instance by default. Set this to "running" only
# when an active Demo is explicitly approved for the current Terraform state.
cost_safety_expected_instance_state = "stopped"
# Delete the static IP too while hibernated to remove its residual charge.
# Set true only if preserving the endpoint is more important than cost.
retain_static_ip_when_instance_deleted = false
