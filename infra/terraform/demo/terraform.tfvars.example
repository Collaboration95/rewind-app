account_id              = "330599756236"
operator_username       = "macos-m1"
backup_bucket_name      = "rewind-demo-backups-330599756236"
audit_bucket_name       = "rewind-audit-logs-330599756236"
# Optional. Leave empty when email notifications are not configured.
budget_email_recipients = []
ssh_cidr                = "YOUR.PUBLIC.IP.ADDRESS/32"
# Leave null for manual starts. Example: "cron(0 9 ? * MON-FRI *)"
automatic_start_schedule_expression = null
# The lifecycle scripts override this for reviewed hibernation/recovery plans.
demo_instance_enabled = true
# Set only when enabling real-auth CloudFront. Generate a random value of at
# least 32 characters; configure the same value at the origin and inject this
# via a protected tfvars/secret workflow. Do not commit the real value.
public_https_origin_auth_header = ""
real_auth_https_distribution_enabled = false
# Delete the static IP too while hibernated to remove its residual charge.
# Set true only if preserving the endpoint is more important than cost.
retain_static_ip_when_instance_deleted = false
