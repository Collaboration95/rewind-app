{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentifyAccount",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ListExactState",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::rewind-terraform-state-330599756236",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "rewind/${environment}/media.tfstate",
          "aws:ResourceAccount": "330599756236"
        }
      }
    },
    {
      "Sid": "ReadExactState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::rewind-terraform-state-330599756236/rewind/${environment}/media.tfstate",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "330599756236"
        }
      }
    },
    {
      "Sid": "MediaConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:GetBucketTagging",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketCORS",
        "s3:GetLifecycleConfiguration",
        "s3:PutBucketTagging",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketCORS",
        "s3:PutLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketWebsite",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetAccelerateConfiguration",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::rewind-${environment}-media-330599756236",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "330599756236"
        }
      }
    },
    {
      "Sid": "RuntimePolicy",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:ListPolicyTags",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::330599756236:policy/rewind-${environment}-private-media"
    },
    {
      "Sid": "DescribeExistingMediaKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": "${kms_key_arn}"
    },
    {
      "Sid": "WriteExactState",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::rewind-terraform-state-330599756236/rewind/${environment}/media.tfstate",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "330599756236"
        }
      }
    },
    {
      "Sid": "StateLockOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::rewind-terraform-state-330599756236/rewind/${environment}/media.tfstate.tflock",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "330599756236"
        }
      }
    },
    {
      "Sid": "CreateMediaInReviewedRegion",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": "arn:aws:s3:::rewind-${environment}-media-330599756236",
      "Condition": {
        "StringEquals": {
          "s3:LocationConstraint": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "ReadPinnedPrivateSavedPlan",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::rewind-terraform-state-330599756236/rewind/${environment}/reviewed-plans/*/*/plan.tfplan",
        "arn:aws:s3:::rewind-terraform-state-330599756236/rewind/${environment}/reviewed-plans/*/*/metadata.json"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "330599756236"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
