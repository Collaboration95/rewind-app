{
  "name": "rewind-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "npm run server:build && node server/dist/cli.js start",
    "server:preflight": "npm run server:build && node server/dist/cli.js preflight",
    "server:migrate": "npm run server:build && node server/dist/cli.js migrate",
    "server:reset": "npm run server:build && node server/dist/cli.js reset",
    "server:diagnostics": "npm run server:build && node server/dist/cli.js diagnostics",
    "server:test": "npm run server:build && node --test server/tests/*.test.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "lint": "eslint .",
    "format": "npm run format:write",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/scaffold.test.mjs tests/architecture.test.mjs && npm run server:test && jest --runInBand",
    "test:responsive": "npm run build:web && playwright test",
    "check": "npm run format:check && npm run lint && npm run architecture:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  }
}
