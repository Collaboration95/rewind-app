{
  "name": "rewind-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "security:doctor": "vigolium doctor",
    "security:auto": "npm run server:build && node scripts/run-vigolium.mjs",
    "security:active": "npm run server:build && node scripts/run-vigolium-active.mjs",
    "security:agentic:prepare": "node scripts/run-vigolium-agentic.mjs --prepare",
    "security:agentic:verify": "npm run server:build && node scripts/run-vigolium-agentic.mjs --verify",
    "security:agentic:run": "npm run server:build && node scripts/run-vigolium-agentic.mjs --run",
    "security:agentic:fixture": "node scripts/run-vigolium-agentic.mjs --verify --fixture",
    "security:agentic:container:build": "node scripts/run-vigolium-container.mjs --build",
    "security:agentic:container:verify": "node scripts/run-vigolium-container.mjs --verify",
    "security:agentic:container:run": "node scripts/run-vigolium-container.mjs --run",
    "security:scan": "vigolium scan --db vigolium-result/http.sqlite --passive-only --only dynamic-assessment --skip-heuristics --scope-origin strict --redirect-mode same-host --rate-limit 5 --scanning-max-duration 5m",
    "security:audit": "vigolium audit --source . --driver audit --agent codex --mode lite --stateless --output-dir vigolium-result/source-audit",
    "start": "expo start",
    "dev:lan": "node scripts/run-local-dev.mjs",
    "web": "expo start --web",
    "build:web": "expo export --clear --platform web --output-dir dist && node scripts/stamp-pwa-build.mjs dist",
    "test:pwa": "npm run build:web && node scripts/check-pwa.mjs dist",
    "web:smoke-server": "node scripts/web-smoke-server.mjs",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "npm run server:build && node server/dist/cli.js start",
    "server:preflight": "npm run server:build && node server/dist/cli.js preflight",
    "server:worker": "npm run server:build && node server/dist/cli.js worker",
    "server:migrate": "npm run server:build && node server/dist/cli.js migrate",
    "server:reset": "npm run server:build && node server/dist/cli.js reset",
    "server:accounts": "npm run server:build && node server/dist/cli.js accounts",
    "server:diagnostics": "npm run server:build && node server/dist/cli.js diagnostics",
    "test:backup-manifest": "bash tests/deploy/backup-manifest.test.sh",
    "test:wake-recovery-selection": "bash tests/deploy/wake-recovery-selection.test.sh",
    "test:lifecycle-guards": "bash tests/deploy/lifecycle-guards.test.sh",
    "test:recovery-smoke": "bash tests/deploy/recovery-smoke.test.sh",
    "test:restore-atomic": "bash tests/deploy/restore-atomic.test.sh",
    "test:ownership-contract": "bash tests/deploy/ownership-contract.test.sh",
    "test:host-preflight": "bash tests/deploy/host-preflight.test.sh",
    "test:host-lifecycle": "node deploy/lifecycle-smoke.mjs",
    "server:test": "npm run server:build && node --test server/tests/*.test.mjs",
    "server:test:postgres": "npm run server:build && node scripts/run-server-tests-postgres.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "lint": "eslint .",
    "format": "npm run format:write",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:root && npm run server:test && jest --runInBand",
    "test:fast": "npm test",
    "test:slow": "npm run build:web && node scripts/check-pwa.mjs dist && playwright test && npm run test:real-account-e2e",
    "test:coverage:frontend": "jest --runInBand --coverage",
    "test:coverage:server": "npm run server:build && NODE_V8_COVERAGE=coverage/server-v8 node --experimental-test-coverage '--test-coverage-include=server/dist/**/*.js' --test server/tests/*.test.mjs",
    "test:a11y": "npm run build:web && playwright test --config=playwright.config.ts tests/responsive/accessibility.spec.ts",
    "test:web-smoke": "playwright test tests/responsive/production-web-routing.spec.ts",
    "test:real-account-e2e": "node scripts/run-real-account-e2e.mjs",
    "test:responsive": "npm run build:web && playwright test",
    "check": "npm run format:check && npm run lint && npm run architecture:check && npm run typecheck && npm test && npm run test:a11y",
    "security:report": "vigolium export --db vigolium-result/http.sqlite --format html -o vigolium-result/http-report.html",
    "postsecurity:scan": "npm run security:report",
    "test:focused": "node scripts/focused-test.mjs",
    "client:prepare": "node scripts/native-build.mjs prepare",
    "test:native-build": "node --test tests/native-build.test.mjs",
    "test:root": "npm run server:build && node scripts/run-root-tests.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "aws-jwt-verify": "5.2.1",
    "braces": "file:vendor/braces/rewind-braces-3.0.3-rewind.1.tgz",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "node-forge": "file:vendor/node-forge/rewind-node-forge-1.4.0-rewind.1.tgz",
    "pg": "8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@vigolium/vigolium": "0.5.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "node-forge": "$node-forge",
    "braces": "$braces"
  }
}
