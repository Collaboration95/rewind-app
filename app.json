{
  "expo": {
    "name": "Rewind",
    "slug": "rewind-app",
    "version": "0.1.0",
    "scheme": "rewind",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./public/icons/rewind-icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#252326"
    },
    "web": {
      "output": "single",
      "favicon": "./public/icons/rewind-icon-512.png",
      "name": "Rewind",
      "shortName": "Rewind",
      "lang": "en",
      "scope": "/",
      "startUrl": "/",
      "themeColor": "#252326",
      "backgroundColor": "#252326",
      "display": "standalone",
      "orientation": "portrait-primary",
      "description": "A local-first time capsule for shared moments."
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Rewind uses the camera to take the photos and videos you share with your group.",
          "microphonePermission": "Rewind records sound with the videos you share with your group.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      "expo-notifications",
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "com.anonymous.rewind-app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.anonymous.rewindapp",
      "versionCode": 1
    },
    "updates": {
      "enabled": false
    }
  }
}
