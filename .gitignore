# Canonical shared skills live in /skills/. The vendor directories below are
# local discovery/runtime locations; only their skills symlink is versioned.
.claude/*
!.claude/skills
.codex/*
!.codex/skills
.opencode/*
!.opencode/skills

# Local agent state and machine-specific files.
.claude/settings.local.json
.codex/settings.local.json
# Per-operator AWS safety skill lives in ~/.codex/skills; never commit a copy.
skills/rewind-aws-operations/
.DS_Store

# Dependencies and generated local output.
node_modules/
.expo/
coverage/
dist/
server/dist/
playwright-report/
test-results/
.local-data/

# Hosted demo secrets and generated backups.
deploy/rewind.env
deploy/rewind.env.*
!deploy/rewind.env.example

# Terraform downloads, state, plans, and per-operator configuration are local.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
backend.hcl

# Generated Python Lambda bytecode.
__pycache__/
*.py[cod]
